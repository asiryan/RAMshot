<UserControl x:Class="RAMshot.Controls.ZoomableImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             ClipToBounds="True"
             Focusable="True"
             Cursor="Arrow"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             SizeChanged="OnViewerSizeChanged"
             MouseWheel="OnMouseWheel"
             MouseDown="OnMouseDown"
             MouseUp="OnMouseUp"
             MouseMove="OnMouseMove"
             LostMouseCapture="OnLostMouseCapture">
 <Grid x:Name="Viewport" Background="Transparent" ClipToBounds="True">
  <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
   <Grid.RenderTransform>
    <TransformGroup>
     <ScaleTransform x:Name="ContentScale"/>
     <TranslateTransform x:Name="ContentTranslate"/>
    </TransformGroup>
   </Grid.RenderTransform>
   <Rectangle RadiusX="4" RadiusY="4">
    <Rectangle.Fill>
     <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute" Stretch="Fill">
      <DrawingBrush.Drawing>
       <DrawingGroup>
        <GeometryDrawing Brush="#111A1E">
         <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#1A272B">
         <GeometryDrawing.Geometry>
          <GeometryGroup>
           <RectangleGeometry Rect="0,0,8,8"/>
           <RectangleGeometry Rect="8,8,8,8"/>
          </GeometryGroup>
         </GeometryDrawing.Geometry>
        </GeometryDrawing>
       </DrawingGroup>
      </DrawingBrush.Drawing>
     </DrawingBrush>
    </Rectangle.Fill>
   </Rectangle>
   <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
  </Grid>
 </Grid>
</UserControl>
