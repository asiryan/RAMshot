<Window x:Class="RAMshot.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RAMshot"
 Title="RAMshot" Icon="pack://application:,,,/RAMshot;component/Assets/RAMshot.ico" Width="1220" Height="790" MinWidth="1000" MinHeight="630"
 WindowStyle="None"
 WindowStartupLocation="CenterScreen" Background="#0B1117" Foreground="#EAF6F3" FontFamily="Segoe UI" FontSize="13">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#141F25"/><SolidColorBrush x:Key="Muted" Color="#8FA6A1"/><SolidColorBrush x:Key="Accent" Color="#5BE5C5"/>
  <local:GalleryColumnsConverter x:Key="GalleryColumns"/>
  <Style x:Key="ButtonKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="-3" BorderBrush="#5BE5C5" BorderThickness="2" CornerRadius="9"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Background" Value="#25363B"/><Setter Property="BorderBrush" Value="#344C4B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C8DAD6"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26383D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#31484D"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="close"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECF8F5"/><Setter Property="Background" Value="#0C171B"/><Setter Property="BorderBrush" Value="#344B48"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,0,9"/><EventSetter Event="PreviewTextInput" Handler="NumberOnly_PreviewTextInput"/><EventSetter Event="DataObject.Pasting" Handler="NumberOnly_Pasting"/><EventSetter Event="TextChanged" Handler="SettingsInputChanged"/></Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="#101D21"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Border Background="{TemplateBinding Background}" CornerRadius="6">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb x:Name="ScrollThumb" MinHeight="24">
         <Thumb.Template><ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbBody" Background="#466D68" CornerRadius="3" Width="5" HorizontalAlignment="Center" Margin="0,2"/>
          <ControlTemplate.Triggers>
           <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="ThumbBody" Property="Width" Value="Auto"/><Setter TargetName="ThumbBody" Property="Height" Value="5"/><Setter TargetName="ThumbBody" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="ThumbBody" Property="VerticalAlignment" Value="Center"/><Setter TargetName="ThumbBody" Property="Margin" Value="2,0"/></DataTrigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#65A69A"/></Trigger>
           <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#5BE5C5"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Thumb.Template>
        </Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
      </Track>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
       <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
       <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
       <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
       <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
       <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Background" Value="#142126"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#284941"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#205047"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="260"/><Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Background" Value="#0C171B"/><Setter Property="BorderBrush" Value="#344B48"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="BoxChrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="7"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#8FA6A1" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BoxChrome" Property="BorderBrush" Value="#5BE5C5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><TextBlock Margin="10,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Select a process, FallbackValue=Select a process}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Width="{TemplateBinding ActualWidth}" MaxHeight="320" Background="#142126" BorderBrush="#344B48" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#5BE5C5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF6F3"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SettingsCheck" TargetType="CheckBox"><Setter Property="Foreground" Value="#D3E7E1"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><EventSetter Event="Click" Handler="SettingsInputChanged"/></Style>
  <Style x:Key="ImageCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1B2A2E"/><Setter Property="BorderBrush" Value="#344B48"/><Setter Property="BorderThickness" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#21433C"/><Setter Property="BorderBrush" Value="#5BE5C5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPreview}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid Margin="28,14,28,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal">
    <Viewbox Width="38" Height="38" Margin="0,0,12,0"><Canvas Width="128" Height="128"><Path Data="M37,12 L37,24 M55,12 L55,24 M73,12 L73,24 M91,12 L91,24 M37,104 L37,116 M55,104 L55,116 M73,104 L73,116 M91,104 L91,116" Stroke="#5BE5C5" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Rectangle Canvas.Left="13" Canvas.Top="24" Width="102" Height="80" RadiusX="11" RadiusY="11" Stroke="#E9F8F5" StrokeThickness="7"/><Path Data="M31,80 L50,62 L62,72 L72,63 L97,80" Stroke="#5BE5C5" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="75" Canvas.Top="47" Width="8" Height="8" Fill="#5BE5C5"/></Canvas></Viewbox>
    <StackPanel><TextBlock FontSize="22" FontWeight="Bold"><Run Text="RAM"/><Run Text="shot" Foreground="#5BE5C5"/></TextBlock><TextBlock Text="FIND IMAGES IN PROCESS MEMORY" Style="{StaticResource Caption}"/></StackPanel>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="480"/><ColumnDefinition Width="0.5*" MinWidth="340" MaxWidth="560"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="#293A3C" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="IMAGE LIBRARY" Foreground="#5BE5C5" FontSize="12" FontWeight="Bold"/>
      <TextBlock Grid.Column="1" Text="{Binding ImageCountLabel}" Foreground="#A7BBB7" VerticalAlignment="Center" FontSize="11"/>
     </Grid>
     <Grid Grid.Row="1" Margin="0,20,0,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="4" Text="SOURCE PROCESS" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
      <ComboBox Grid.Row="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Margin="0,0,8,0" MinWidth="0" ToolTip="Select a process">
       <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Row="1" Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Refresh the process list"/>
      <Button Grid.Row="1" Grid.Column="2" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Pause or resume scanning"/>
      <Button Grid.Row="1" Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButton}" Margin="0" ToolTip="Clear the image library"/>
     </Grid>
     <Grid Grid.Row="2"><Border CornerRadius="8" Background="#0D171C"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12"><ItemsControl ItemsSource="{Binding Images}" VerticalAlignment="Top"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource GalleryColumns}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ImageCard}" Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4" Padding="5" AutomationProperties.Name="{Binding CardLabel}"><StackPanel><Border Background="#0A1317" CornerRadius="4" Height="112"><Image Source="{Binding Image}" Stretch="Uniform"/></Border><TextBlock Text="{Binding CardLabel}" TextTrimming="CharacterEllipsis" Foreground="#C8DAD6" FontSize="11" Margin="3,7,0,2"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="350"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Images.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="No images yet" FontSize="16" FontWeight="SemiBold" Foreground="#C9DEDA" HorizontalAlignment="Center"/></StackPanel></Grid>
     <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="#91A8A3" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Style="{StaticResource ActionButton}" ToolTip="Copy the selected image to the clipboard"/><Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}" ToolTip="Save the selected image to a file in its format"/><Button Content="Settings" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource ToolbarButton}" Margin="0" ToolTip="Show or hide scan settings"/></StackPanel></Grid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#293A3C" BorderThickness="1" CornerRadius="14" Padding="18" Visibility="{Binding PreviewVisibility}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="IMAGE PREVIEW" Foreground="#5BE5C5" FontSize="12" FontWeight="Bold"/><Border Grid.Row="1" Background="#0D171C" CornerRadius="8" Margin="0,16,0,12"><Grid><Image Source="{Binding SelectedPreview}" Stretch="Uniform"/><TextBlock Text="Select an image to preview" Foreground="#718783" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><Grid Grid.Row="2" MinHeight="36"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFormatLabel}" Foreground="#A7BBB7" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedFormatLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding SelectedRegionLabel}" Foreground="#A7BBB7" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedRegionLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></Grid>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#293A3C" BorderThickness="1" CornerRadius="14" Padding="18" Visibility="{Binding SettingsVisibility}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="SCAN SETTINGS" Foreground="#5BE5C5" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="READ LIMIT / BATCH (MiB)" Style="{StaticResource Caption}"/><TextBox Text="{Binding ReadMiB}"/>
      <TextBlock Text="IMAGE FILE LIMIT (MiB)" Style="{StaticResource Caption}"/><TextBox Text="{Binding ImageMiB}"/>
      <TextBlock Text="BATCH TIME (seconds)" Style="{StaticResource Caption}"/><TextBox Text="{Binding BatchSeconds}"/>
      <TextBlock Text="MAX IMAGES PER BATCH" Style="{StaticResource Caption}"/><TextBox Text="{Binding MaxCandidates}"/>
      <TextBlock Text="MAX SIGNATURES PER BATCH" Style="{StaticResource Caption}"/><TextBox Text="{Binding MaxSignatures}"/>
      <TextBlock Text="DECODED IMAGES PER BATCH (MiB)" Style="{StaticResource Caption}"/><TextBox Text="{Binding MaxDecodedMiB}"/>
      <TextBlock Text="MIN / MAX IMAGE SIZE (px)" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding MinDimension}"/><TextBox Grid.Column="2" Text="{Binding MaxDimension}"/></Grid>
      <TextBlock Text="IMAGES PER RUN" Style="{StaticResource Caption}"/><TextBox Text="{Binding MaxImages}"/>
      <TextBlock Text="GALLERY MEMORY (MiB)" Style="{StaticResource Caption}"/><TextBox Text="{Binding GalleryMiB}"/>
      <TextBlock Text="PAUSE BETWEEN BATCHES (ms)" Style="{StaticResource Caption}"/><TextBox Text="{Binding IntervalMs}"/>
      <CheckBox Content="Mapped regions" IsChecked="{Binding IncludeMappedRegions}" Style="{StaticResource SettingsCheck}" ToolTip="Search images in file-mapped views as well"/>
      <CheckBox Content="Image module regions" IsChecked="{Binding IncludeImageRegions}" Style="{StaticResource SettingsCheck}" ToolTip="Search images in loaded module images (DLL/EXE resources) as well"/>
      <CheckBox Content="Enable Ctrl + Shift + F12" IsChecked="{Binding HotkeyEnabled}" Style="{StaticResource SettingsCheck}"/>
    </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding SettingsStatus}" Foreground="#A7BBB7" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SettingsStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="{Binding ApplyLabel}" Command="{Binding ApplySettingsCommand}" ToolTip="Save the current scan settings" Background="#5BE5C5" Foreground="#09221C" BorderBrush="#5BE5C5" FontWeight="SemiBold" Margin="0"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Memory resources may be unrelated to the current screen" Foreground="#8FA6A1" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding HotkeyHelp}" Foreground="#718783" FontSize="12" VerticalAlignment="Center"/></Grid>
  </Grid>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
   <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
   <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
   <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Tag="close" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
  </StackPanel>
 </Grid>
</Window>







